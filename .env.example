# Ghana Services App — copy this file to `.env` and fill in the values.
# NEVER commit a real `.env` file or paste real keys here.
# Only the API (Stack 2) reads this file; the frontend uses frontend/config.js.

# --- REST API (Render / local dev) ---------------------------------------
# Postgres connection string (Neon, Supabase Postgres, or local Postgres).
# Neon gives you this in the dashboard; it ends with ?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Long random secret for signing login tokens. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Local port for the API (Render sets PORT itself).
PORT=3000

# The public URL of the frontend, for CORS (e.g. your Render static site
# or Cloudflare Pages URL). Leave unset for local development.
FRONTEND_URL=http://localhost:8080

# --- Supabase mode (Cloudflare Pages frontend) ---------------------------
# Only needed if you use Stack 1. Find these in Supabase:
# Project Settings -> API. The anon key is safe to ship in the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
